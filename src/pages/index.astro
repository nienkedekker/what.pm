---
import BaseLayout from "../layouts/BaseLayout.astro";
import NowPlaying from "../components/now-playing";
import ReadingCard from "../components/reading-card";
import KanjiCard from "../components/kanji-card";
import MediaChart from "../components/media-chart";
import { getEntry, render } from "astro:content";
import ArrowRight from "phosphor-astro/ArrowRight.astro";
import MapPin from "phosphor-astro/MapPin.astro";
import { profile, site } from "../data/profile";
import { getHomeSnapshot } from "../lib/home-snapshot";

const home = await getEntry("pages", "home");
const now = await getEntry("pages", "now");
const { Content: HomeIntro } = await render(home!);
// The cards' live data as of this build, so the page has real content
// without JavaScript. The cards refresh it in the browser.
const { summary, progress, track } = await getHomeSnapshot();

const nowUpdated = now?.data.lastUpdated?.toLocaleDateString("en-US", {
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});

// Who this site is about, for search engines and agents (schema.org Person)
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${site}/#person`,
  name: profile.name,
  url: `${site}/`,
  description: profile.description,
  image: profile.image,
  jobTitle: profile.jobTitle,
  email: `mailto:${profile.email}`,
  worksFor: { "@type": "Organization", ...profile.employer },
  address: {
    "@type": "PostalAddress",
    addressLocality: profile.locality,
    addressCountry: profile.country,
  },
  knowsAbout: profile.skills,
  sameAs: profile.profiles.map(({ href }) => href),
};

const sectionHeading =
  "text-ink text-3xl font-semibold tracking-[-0.035em] sm:text-5xl";
---

<BaseLayout markdown="/index.md">
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(personSchema).replace(/</g, "\\u003c")}
  />

  <!-- ─────────────── Hero ─────────────── -->
  <section
    class="mx-auto grid max-w-6xl items-center gap-y-16 px-4 pt-16 sm:pt-28 lg:grid-cols-12 lg:gap-x-16"
  >
    <div class="lg:col-span-7">
      <h1
        class="rise text-ink text-[clamp(3rem,7.5vw,5.5rem)] leading-[1.02] font-semibold tracking-[-0.045em]"
        style="--delay: 100ms"
      >
        Hoi, I'm Nienke.
      </h1>

      <div
        class="rise mt-6 max-w-lg text-lg leading-relaxed text-ink-soft [&_a]:text-ink [&_a]:underline [&_a]:decoration-line-strong [&_a]:underline-offset-4 [&_a:hover]:decoration-ink [&_p+p]:mt-4"
        style="--delay: 200ms"
      >
        <HomeIntro />
      </div>

      <div class="rise mt-9 flex flex-wrap gap-3" style="--delay: 300ms">
        <a href="mailto:nienkedekker@gmail.com" class="btn btn-primary">
          Get in touch <ArrowRight class="size-4" />
        </a>
        <a href="/now" class="btn btn-secondary">What I'm up to</a>
      </div>
    </div>

    <figure
      class="rise relative mx-auto w-full max-w-sm rounded-[1.25rem] border border-line bg-panel p-1.5 shadow-[0_30px_120px_-40px_var(--glow)] sm:max-w-md lg:col-span-5 lg:max-w-none"
      style="--delay: 200ms"
    >
      <img
        src="/nienke.jpg"
        alt="Nienke gazing out over the port of Hydra"
        class="aspect-[4/5] w-full rounded-[0.9rem] object-cover"
        width="934"
        height="1168"
      />
      <figcaption
        class="absolute bottom-5 left-5 flex items-center gap-1.5 rounded-full border border-white/15 bg-black/40 px-3 py-1 text-xs text-white backdrop-blur-md"
      >
        <MapPin class="size-3.5" /> Hydra, Greece
      </figcaption>
    </figure>
  </section>

  <!-- ─────────────── Right now ─────────────── -->
  <section
    class="mx-auto mt-32 max-w-6xl px-4 sm:mt-44"
    aria-labelledby="now-heading"
  >
    <div
      data-reveal
      class="mb-10 flex flex-wrap items-end justify-between gap-6"
    >
      <div>
        <h2 id="now-heading" class={sectionHeading}>Right now</h2>
        <p class="mt-3 max-w-md text-ink-soft">
          Live from the things I log, read, study and listen to.
        </p>
      </div>
      <a
        href="/now"
        class="group flex items-center gap-1.5 text-sm text-ink-soft transition-colors hover:text-ink"
      >
        The full /now page{nowUpdated && ` · ${nowUpdated}`}
        <ArrowRight
          class="size-3.5 transition-transform group-hover:translate-x-0.5"
        />
      </a>
    </div>

    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <!-- This year in media, live from what.pm -->
      <article data-reveal class="card p-6 sm:col-span-2 sm:p-7">
        <MediaChart client:visible initial={summary} />
      </article>

      <!-- Japanese, live from WaniKani -->
      <article
        data-reveal
        style="--delay: 60ms"
        class="card p-6 sm:p-7 lg:row-span-2"
      >
        <KanjiCard client:visible initial={progress} />
      </article>

      <!-- Now playing -->
      <article
        data-reveal
        style="--delay: 120ms"
        class="card p-6 sm:p-7 lg:row-span-2"
      >
        <NowPlaying client:load initial={track} />
      </article>

      <!-- Reading, live from what.pm -->
      <article data-reveal class="card p-6 sm:col-span-2 sm:p-7">
        <ReadingCard client:visible initial={summary} />
      </article>
    </div>
  </section>
</BaseLayout>
