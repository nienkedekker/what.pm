---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/header.astro';
import Footer from '../../components/footer.astro';
import PostCard from '../../components/post-card.astro';
import { sanityClient } from 'sanity:client';
import { tripsQuery } from '../../sanity/queries';

const trips = await sanityClient.fetch(tripsQuery);
---

<BaseLayout title="Trips" description="Travel stories and adventures">
  <Header slot="header" />

  <section>
    <h1 class="font-serif text-3xl font-bold mb-2">Trips</h1>
    <p class="text-gray-600 dark:text-gray-400 mb-8">
      Travel stories and adventures from around the world.
    </p>

    {trips.length > 0 ? (
      <div>
        {trips.map((trip: any) => (
          <PostCard
            title={trip.title}
            href={`/trips/${trip.slug.current}`}
            date={new Date(trip.date)}
            description={trip.description}
            location={trip.location}
          />
        ))}
      </div>
    ) : (
      <p class="text-gray-600 dark:text-gray-400">No trips yet. Check back soon!</p>
    )}
  </section>

  <Footer slot="footer" />
</BaseLayout>
