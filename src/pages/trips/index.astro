---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/header.astro";
import Footer from "../../components/footer.astro";
import PostCard from "../../components/post-card.astro";
import { sanityClient } from "sanity:client";
import { tripsQuery } from "../../sanity/queries";
import { getSparkle } from "../../utils/sparkles";
import type { Trip } from "../../types/sanity";

const trips: Trip[] = await sanityClient.fetch(tripsQuery);
---

<BaseLayout title="Trips" description="Travel stories and adventures">
  <Header slot="header" />

  <section>
    <h1 class="font-serif text-3xl font-bold mb-2">Trips</h1>
    <p class="text-gray-600 dark:text-gray-400 mb-8 text-sm">
      Places I've been, places I'm going.
    </p>

    {
      trips.length > 0 ? (
        <ul class="list-none space-y-2">
          {trips.map((trip, index) => (
            <li
              class="trip-item group/trip"
              style={`--sparkle: "${getSparkle(index)}"`}
            >
              <PostCard
                title={trip.title}
                href={`/trips/${trip.slug.current}`}
                date={new Date(trip.date)}
                description={trip.description}
                location={trip.location}
                monthOnly
              />
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-gray-600 dark:text-gray-400">
          No trips yet. Check back soon!
        </p>
      )
    }
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .trip-item {
    list-style: none;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .trip-item::before {
    content: var(--sparkle);
    color: rgb(168 162 158); /* stone-400 */
    font-size: 0.875rem;
    flex-shrink: 0;
  }

  .trip-item:hover::before {
    color: rgb(251 146 60); /* orange-400 */
  }

  :global(.dark) .trip-item::before {
    color: rgb(120 113 108); /* stone-500 */
  }

  :global(.dark) .trip-item:hover::before {
    color: rgb(251 146 60); /* orange-400 */
  }
</style>
