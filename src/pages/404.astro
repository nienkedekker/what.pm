---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowLeftBold from "phosphor-astro/ArrowLeftBold.astro";
---

<BaseLayout title="Lost" description="This page flew away.">
  <section
    class="mx-auto flex max-w-3xl flex-col items-center px-4 pt-24 text-center sm:pt-32"
  >
    <h1
      class="rise font-display text-[clamp(3.5rem,11vw,7rem)] leading-[0.95] font-bold tracking-[-0.035em]"
      style="--delay: 160ms"
    >
      This page <span class="text-accent">flew away</span>.
    </h1>
    <p class="rise mt-6 max-w-md text-lg text-ink-soft" style="--delay: 240ms">
      Maybe it was one of my old blog posts. I retired those, but the rest of
      the site is still here.
    </p>
    <a href="/" class="btn btn-accent rise mt-8" style="--delay: 320ms">
      <ArrowLeftBold class="size-4" /> Back home
    </a>
  </section>
</BaseLayout>
