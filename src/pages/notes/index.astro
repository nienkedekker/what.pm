---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/header.astro';
import Footer from '../../components/footer.astro';
import PostCard from '../../components/post-card.astro';
import { sanityClient } from 'sanity:client';
import { notesQuery } from '../../sanity/queries';

const notes = await sanityClient.fetch(notesQuery);
---

<BaseLayout title="Notes" description="Thoughts, ideas, and observations">
  <Header slot="header" />

  <section>
    <h1 class="font-serif text-3xl font-bold mb-2">Notes</h1>
    <p class="text-gray-600 dark:text-gray-400 mb-8">
      Short-form thoughts, ideas, and observations.
    </p>

    {notes.length > 0 ? (
      <div>
        {notes.map((note: any) => (
          <PostCard
            title={note.title}
            href={`/notes/${note.slug.current}`}
            date={new Date(note.date)}
            description={note.description}
          />
        ))}
      </div>
    ) : (
      <p class="text-gray-600 dark:text-gray-400">No notes yet. Check back soon!</p>
    )}
  </section>

  <Footer slot="footer" />
</BaseLayout>
