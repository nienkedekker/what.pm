---
import PageLayout from "../layouts/PageLayout.astro";
import GuestbookForm from "../components/guestbook-form";
import { getGuestbookEntries, type GuestbookEntry } from "../lib/redis";

// Rendered on each request so new messages show up straight away
export const prerender = false;

let entries: GuestbookEntry[] = [];
try {
  entries = await getGuestbookEntries();
} catch (error) {
  console.error("Couldn't load guestbook entries:", error);
}

function formatDate(dateString: string) {
  return new Date(dateString).toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}
---

<PageLayout title="Guestbook" intro="Leave a message! Don't be weird please.">
  <div class="grid gap-14 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <div
        class="border-2 border-t-white border-r-gray-700 border-b-gray-700 border-l-white bg-[#c0c0c0] p-1 lg:sticky lg:top-20"
      >
        <div
          class="mb-1 flex items-center justify-between bg-gradient-to-r from-[#000080] to-[#1084d0] px-2 py-1 font-mono text-xs font-bold text-white"
        >
          <span>sign_guestbook.exe</span>
          <span aria-hidden="true" class="flex gap-1">
            {
              ["_", "□", "✕"].map((glyph) => (
                <span class="grid size-4 place-items-center border border-t-white border-r-gray-700 border-b-gray-700 border-l-white bg-[#c0c0c0] text-[0.6rem] leading-none text-black">
                  {glyph}
                </span>
              ))
            }
          </span>
        </div>
        <GuestbookForm client:load />
      </div>
    </div>

    <div class="lg:col-span-7">
      <p class="mb-6 text-ink-soft">
        {entries.length}
        {entries.length === 1 ? "message" : "messages"} so far
      </p>

      {
        entries.length > 0 ? (
          <ul class="columns-1 gap-4 sm:columns-2">
            {entries.map((entry) => (
              <li data-reveal class="card mb-4 break-inside-avoid p-5">
                <p class="leading-relaxed whitespace-pre-wrap">
                  {entry.message}
                </p>
                <div class="mt-4 flex items-baseline justify-between gap-2 border-t border-line pt-3 text-sm">
                  <span class="font-medium">
                    {entry.website ? (
                      <a
                        href={entry.website}
                        target="_blank"
                        rel="noopener noreferrer nofollow ugc"
                        class="underline decoration-line-strong underline-offset-4 hover:decoration-ink"
                      >
                        {entry.name}
                      </a>
                    ) : (
                      entry.name
                    )}
                  </span>
                  <time
                    datetime={entry.createdAt}
                    class="shrink-0 font-mono text-xs text-ink-faint"
                  >
                    {formatDate(entry.createdAt)}
                  </time>
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-ink-soft">No messages yet. Be the first to sign!</p>
        )
      }
    </div>
  </div>
</PageLayout>
