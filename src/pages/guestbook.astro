---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import GuestbookSection from "../components/guestbook-section";
---

<BaseLayout title="Guestbook" description="Sign my guestbook!">
  <Header slot="header" />

  <section>
    <h1 class="font-serif text-3xl font-bold mb-2">Guestbook</h1>
    <p class="text-gray-600 dark:text-gray-400 mb-8">
      Leave a message! Don't be weird please.
    </p>

    <GuestbookSection client:load />
  </section>

  <Footer slot="footer" />
</BaseLayout>
