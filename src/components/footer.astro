---
import GithubLogoDuotone from "phosphor-astro/GithubLogoDuotone.astro";
import LinkedinLogoDuotone from "phosphor-astro/LinkedinLogoDuotone.astro";
import ArrowUpRightBold from "phosphor-astro/ArrowUpRightBold.astro";
import HitCounter from "./hit-counter";

const email = "nienkedekker@gmail.com";

const socials = [
  {
    href: "https://github.com/nienkedekker",
    label: "GitHub",
    Icon: GithubLogoDuotone,
  },
  {
    href: "https://www.linkedin.com/in/nienke-dekker-15348ab1/",
    label: "LinkedIn",
    Icon: LinkedinLogoDuotone,
  },
];

const smallLinks = [
  { href: "/colophon", label: "Colophon" },
  { href: "/guestbook", label: "Guestbook" },
  { href: "/links", label: "Links" },
];
---

<footer class="mx-auto mt-32 max-w-6xl px-4 pb-10">
  <div
    class="on-accent relative overflow-hidden rounded-[1.75rem] bg-cobalt px-6 pt-12 pb-8 sm:px-12 sm:pt-16"
  >
    <p class="relative text-lg text-ink-soft">
      Got a question, a project, or a good book recommendation?
    </p>
    <a
      href={`mailto:${email}`}
      class="group relative mt-4 block font-display text-[clamp(4rem,15vw,11rem)] leading-[0.9] font-bold tracking-[-0.04em]"
    >
      Say <em class="text-lime">hoi</em><ArrowUpRightBold
        class="ml-2 inline-block size-[0.5em] align-baseline transition-transform duration-300 group-hover:translate-x-2 group-hover:-translate-y-2"
      />
    </a>
    <p class="relative mt-5 font-mono text-sm text-ink-soft">{email}</p>

    <div
      class="relative mt-12 flex flex-col gap-6 border-t border-white/20 pt-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <div
        class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-medium"
      >
        {
          socials.map(({ href, label, Icon }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-1.5 transition-colors hover:text-lime"
            >
              <Icon class="size-4" />
              {label}
            </a>
          ))
        }
        <span class="hidden text-white/40 sm:inline" aria-hidden="true">/</span>
        {
          smallLinks.map(({ href, label }) => (
            <a
              href={href}
              class="text-ink-soft transition-colors hover:text-lime"
            >
              {label}
            </a>
          ))
        }
      </div>
      <HitCounter client:load />
    </div>
  </div>

  <div
    class="mt-6 flex flex-col-reverse items-center justify-between gap-4 text-xs text-ink-faint sm:flex-row"
  >
    <p>© {new Date().getFullYear()} Nienke Dekker · Made in Amsterdam</p>
    <div
      class="flex flex-wrap items-center justify-center gap-2 [image-rendering:pixelated]"
    >
      <img
        src="/buttons/poweredbymac.gif"
        alt="Powered by Mac"
        width="88"
        height="31"
      />
      <img
        src="/buttons/cookiefree.gif"
        alt="Cookie free"
        width="88"
        height="31"
      />
      <button
        id="bookmark-btn"
        class="cursor-pointer"
        title="Bookmark this page"
      >
        <img
          src="/buttons/bookmark.gif"
          alt="Bookmark this page"
          width="88"
          height="31"
        />
      </button>
      <img src="/buttons/3computer.jpg" alt="Computer" width="88" height="31" />
    </div>
  </div>
</footer>

<script>
  function setupBookmarkButton() {
    document.getElementById("bookmark-btn")?.addEventListener("click", () => {
      const isMac = navigator.platform.toUpperCase().indexOf("MAC") >= 0;
      const shortcut = isMac ? "⌘+D" : "Ctrl+D";
      alert(
        `RIP window.external.AddFavorite :( Press ${shortcut} to bookmark this page!`
      );
    });
  }

  document.addEventListener("astro:page-load", setupBookmarkButton);
</script>
