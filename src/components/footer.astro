---
import ArrowRight from "phosphor-astro/ArrowRight.astro";
import HitCounter from "./hit-counter";

const email = "nienkedekker@gmail.com";

const columns = [
  {
    title: "Site",
    links: [
      { href: "/now", label: "Now" },
      { href: "/uses", label: "Uses" },
      { href: "/links", label: "Links" },
      { href: "/guestbook", label: "Guestbook" },
      { href: "/colophon", label: "Colophon" },
    ],
  },
  {
    title: "Elsewhere",
    links: [
      { href: "https://github.com/nienkedekker", label: "GitHub" },
      {
        href: "https://www.linkedin.com/in/nienke-dekker-15348ab1/",
        label: "LinkedIn",
      },
      { href: "https://www.what.pm/", label: "what.pm" },
      { href: `mailto:${email}`, label: "Email" },
    ],
  },
];

const isExternal = (href: string) => /^(https?:|mailto:)/.test(href);
---

<section
  class="relative mx-auto mt-40 max-w-6xl px-4 text-center"
  aria-labelledby="say-hoi"
>
  <div
    class="pointer-events-none absolute inset-x-0 -top-24 -z-10 mx-auto h-72 max-w-3xl bg-[radial-gradient(ellipse_50%_60%_at_50%_50%,var(--glow),transparent)]"
    aria-hidden="true"
  >
  </div>
  <h2
    id="say-hoi"
    data-reveal
    class="text-ink text-5xl font-semibold tracking-[-0.04em] sm:text-7xl"
  >
    Say hoi.
  </h2>
  <p data-reveal class="mx-auto mt-5 max-w-md text-lg text-ink-soft">
    Got a question, a project, or a good book recommendation?
  </p>
  <div data-reveal class="mt-8 flex flex-wrap justify-center gap-3">
    <a href={`mailto:${email}`} class="btn btn-primary">
      {email}
      <ArrowRight class="size-4" />
    </a>
    <a href="/guestbook" class="btn btn-secondary">Sign the guestbook</a>
  </div>
</section>

<footer class="mt-32 border-t border-line">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:grid-cols-[1fr_auto]">
    <div class="flex flex-col gap-4">
      <a href="/" class="flex items-center gap-2.5 text-sm font-semibold">
        <span
          class="grid size-6 place-items-center rounded-md bg-ink text-[0.65rem] font-bold text-paper"
          aria-hidden="true">nd</span
        >
        Nienke Dekker
      </a>
      <p class="text-sm text-ink-faint">
        © {new Date().getFullYear()} · Made in Amsterdam
      </p>
      <HitCounter client:load />
    </div>

    <div class="grid grid-cols-2 gap-x-16 gap-y-8 text-sm">
      {
        columns.map(({ title, links }) => (
          <div>
            <p class="font-medium">{title}</p>
            <ul class="mt-3 space-y-2">
              {links.map(({ href, label }) => (
                <li>
                  <a
                    href={href}
                    class="text-ink-soft transition-colors hover:text-ink"
                    {...(isExternal(href) && !href.startsWith("mailto:")
                      ? { target: "_blank", rel: "noopener noreferrer" }
                      : {})}
                  >
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>

  <div class="border-t border-line">
    <div
      class="mx-auto flex max-w-6xl flex-wrap items-center gap-2 px-4 py-5 opacity-60 transition-opacity [image-rendering:pixelated] hover:opacity-100"
    >
      <img
        src="/buttons/poweredbymac.gif"
        alt="Powered by Mac"
        width="88"
        height="31"
      />
      <img
        src="/buttons/cookiefree.gif"
        alt="Cookie free"
        width="88"
        height="31"
      />
      <button
        id="bookmark-btn"
        class="cursor-pointer"
        title="Bookmark this page"
      >
        <img
          src="/buttons/bookmark.gif"
          alt="Bookmark this page"
          width="88"
          height="31"
        />
      </button>
      <img src="/buttons/3computer.jpg" alt="Computer" width="88" height="31" />
    </div>
  </div>
</footer>

<script>
  function setupBookmarkButton() {
    document.getElementById("bookmark-btn")?.addEventListener("click", () => {
      const isMac = navigator.platform.toUpperCase().indexOf("MAC") >= 0;
      const shortcut = isMac ? "⌘+D" : "Ctrl+D";
      alert(
        `RIP window.external.AddFavorite :( Press ${shortcut} to bookmark this page!`
      );
    });
  }

  document.addEventListener("astro:page-load", setupBookmarkButton);
</script>
