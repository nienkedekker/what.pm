---
// Live Amsterdam time, plus a guess at what I'm doing right now
---

<span class="inline-flex flex-wrap items-center gap-x-2">
  <time data-clock class="tabular-nums">--:--</time>
  <span aria-hidden="true">·</span>
  <span data-clock-status>probably online</span>
</span>

<script>
  const formatter = new Intl.DateTimeFormat("en-GB", {
    timeZone: "Europe/Amsterdam",
    hour: "2-digit",
    minute: "2-digit",
    weekday: "short",
    hour12: false,
  });

  function status(hour: number, weekday: string) {
    const weekend = weekday === "Sat" || weekday === "Sun";
    if (hour < 7 || hour >= 23) return "probably asleep";
    if (!weekend && hour >= 9 && hour < 18)
      return "probably building dashboards";
    if (hour < 9) return "probably journaling";
    return "probably reading";
  }

  let timer: ReturnType<typeof setInterval> | undefined;

  function tick() {
    const clock = document.querySelector<HTMLTimeElement>("[data-clock]");
    const label = document.querySelector("[data-clock-status]");
    if (!clock || !label) return;

    const parts = Object.fromEntries(
      formatter.formatToParts(new Date()).map((p) => [p.type, p.value])
    );
    clock.textContent = `${parts.hour}:${parts.minute}`;
    label.textContent = status(Number(parts.hour), parts.weekday);
  }

  document.addEventListener("astro:page-load", () => {
    clearInterval(timer);
    tick();
    timer = setInterval(tick, 15_000);
  });
</script>
