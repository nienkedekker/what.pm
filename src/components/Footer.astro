---
const links = [
  { href: 'mailto:nienkedekker@gmail.com', label: 'Email' },
  { href: 'https://github.com/nienkedekker', label: 'GitHub' },
  { href: 'https://www.linkedin.com/in/nienke-dekker-15348ab1/', label: 'LinkedIn' },
  { href: '/rss.xml', label: 'RSS' },
];
---

<footer class="mt-16 pt-8 border-t border-gray-200 dark:border-neutral-700">
  <div class="flex flex-wrap gap-4 text-sm text-gray-600 dark:text-gray-400">
    {links.map(({ href, label }) => (
      <a
        href={href}
        class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
        target={href.startsWith('http') || href.startsWith('mailto') ? '_blank' : undefined}
        rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
      >
        {label}
      </a>
    ))}
  </div>
</footer>
