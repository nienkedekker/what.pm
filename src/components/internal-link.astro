---
const props = Astro.props as any;
const reference = props.node?.markDef?.reference;

function getUrl(type: string, slug: string): string {
  switch (type) {
    case "note":
      return `/notes/${slug}`;
    case "trip":
      return `/trips/${slug}`;
    case "page":
      return `/${slug}`;
    default:
      return `/${slug}`;
  }
}

const href = reference ? getUrl(reference._type, reference.slug) : "#";
---

<a href={href} class="text-accent dark:text-accent-light hover:underline"><slot /></a>
