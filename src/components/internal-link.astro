---
import type { MarkProps } from "astro-portabletext/types";

interface InternalLinkMarkDef {
  reference?: {
    _type: string;
    slug: string;
  };
}

type Props = MarkProps<InternalLinkMarkDef>;

const { node } = Astro.props;
const reference = node.markDef?.reference;

// Only pages have their own URL now (e.g. /colophon, /uses). Notes and trips
// were retired, so links to them render as plain text.
const href = reference?._type === "page" ? `/${reference.slug}` : undefined;
---

{
  href ? (
    <a href={href}>
      <slot />
    </a>
  ) : (
    <slot />
  )
}
