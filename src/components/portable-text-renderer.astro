---
import { PortableText } from "astro-portabletext";
import SanityImage from "./sanity-image.astro";
import SanityGallery from "./sanity-gallery.astro";
import SanityInlineImage from "./sanity-inline-image.astro";
import InternalLink from "./internal-link.astro";

interface Props {
  value: any;
}

const { value } = Astro.props;

const components = {
  type: {
    image: SanityImage,
    gallery: SanityGallery,
    inlineImage: SanityInlineImage,
  },
  mark: {
    internalLink: InternalLink,
  },
};
---

<PortableText value={value} components={components} />
