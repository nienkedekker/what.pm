---
import SunDuotone from "phosphor-astro/SunDuotone.astro";
import MoonDuotone from "phosphor-astro/MoonDuotone.astro";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const navItems = [
  { href: "/now", label: "Now" },
  { href: "/uses", label: "Uses" },
  { href: "/links", label: "Links" },
  { href: "/guestbook", label: "Guestbook" },
];
---

<header
  class="sticky top-0 z-40 px-4 pt-4 pb-3 before:pointer-events-none before:absolute before:inset-0 before:-z-10 before:bg-gradient-to-b before:from-paper before:from-40% before:to-transparent sm:pt-5"
  transition:persist
  transition:name="site-header"
>
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-2"
    aria-label="Main"
  >
    <a
      href="/"
      class="group flex items-center gap-2.5 font-display text-lg leading-none font-bold tracking-tight"
      aria-label="Nienke Dekker, home"
    >
      <span
        class="grid size-10 place-items-center rounded-xl bg-cobalt text-[0.95rem] text-white transition-colors group-hover:bg-ink group-hover:text-paper"
        aria-hidden="true">nd</span
      >
      <span class="hidden sm:inline">Nienke Dekker</span>
    </a>

    <div class="flex items-center gap-1 sm:gap-1.5">
      <ul
        class="flex items-center rounded-full border border-line bg-card/85 p-1 text-[0.8rem] font-medium backdrop-blur-md sm:text-sm"
      >
        {
          navItems.map(({ href, label }) => (
            <li>
              <a
                href={href}
                data-nav-link
                aria-current={currentPath === href ? "page" : undefined}
                class="block rounded-full px-2.5 py-1.5 text-ink-soft transition-colors hover:text-ink aria-[current=page]:bg-ink aria-[current=page]:text-paper sm:px-4"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
      <button
        id="theme-toggle"
        class="grid size-9 shrink-0 place-items-center rounded-full border border-line bg-card/85 text-ink-soft backdrop-blur-md transition-colors hover:border-ink hover:text-ink sm:size-10"
        aria-label="Toggle dark mode"
      >
        <SunDuotone class="hidden size-5 dark:block" />
        <MoonDuotone class="block size-5 dark:hidden" />
      </button>
    </div>
  </nav>
</header>

<script>
  // The header persists across page transitions, so keep aria-current in sync
  function syncActiveLink() {
    const path = location.pathname.replace(/\/$/, "") || "/";
    document
      .querySelectorAll<HTMLAnchorElement>("[data-nav-link]")
      .forEach((link) => {
        if (link.pathname === path) link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
      });
  }

  function setupThemeToggle() {
    const toggle = document.getElementById("theme-toggle");
    if (!toggle || toggle.dataset.bound) return;
    toggle.dataset.bound = "true";
    toggle.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });
  }

  document.addEventListener("astro:page-load", () => {
    syncActiveLink();
    setupThemeToggle();
  });
</script>
