---
import HouseDuotone from 'phosphor-astro/HouseDuotone.astro';
import AirplaneDuotone from 'phosphor-astro/AirplaneDuotone.astro';
import NotePencilDuotone from 'phosphor-astro/NotePencilDuotone.astro';
import ClockDuotone from 'phosphor-astro/ClockDuotone.astro';
import LinkDuotone from 'phosphor-astro/LinkDuotone.astro';
import ChatsCircleDuotone from 'phosphor-astro/ChatsCircleDuotone.astro';
import SunDuotone from 'phosphor-astro/SunDuotone.astro';
import MoonDuotone from 'phosphor-astro/MoonDuotone.astro';

const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Home', Icon: HouseDuotone },
  { href: '/trips', label: 'Trips', Icon: AirplaneDuotone },
  { href: '/notes', label: 'Notes', Icon: NotePencilDuotone },
  { href: '/links', label: 'Links', Icon: LinkDuotone },
  { href: '/guestbook', label: 'Guestbook', Icon: ChatsCircleDuotone },
  { href: '/now', label: 'Now', Icon: ClockDuotone },
];

const linkClass = (href: string) => [
  'flex items-center gap-1.5 p-2 sm:p-0 hover:text-accent dark:hover:text-accent-light transition-colors',
  currentPath === href || (href !== '/' && currentPath.startsWith(href))
    ? 'text-accent dark:text-accent-light'
    : 'text-gray-600 dark:text-gray-400'
];
---

<header class="mb-12">
  <nav class="flex items-center justify-between">
    <a href="/" class="font-serif text-xl font-semibold hover:text-accent dark:hover:text-accent-light">
      nienke.dev
    </a>
    <ul class="flex gap-2 sm:gap-6 text-sm">
      {navItems.map(({ href, label, Icon }) => (
        <li>
          <a href={href} class:list={linkClass(href)} title={label}>
            <Icon class="size-[18px] sm:size-4" />
            <span class="hidden sm:inline">{label}</span>
          </a>
        </li>
      ))}
    </ul>
    <button
      id="theme-toggle"
      class="p-2 rounded-lg text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-neutral-800"
      aria-label="Toggle dark mode"
    >
      <SunDuotone class="size-5 hidden dark:block" />
      <MoonDuotone class="size-5 block dark:hidden" />
    </button>
  </nav>
</header>

<script>
  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });
</script>
