---
import CalendarDuotone from "phosphor-astro/CalendarDuotone.astro";
import MapPinDuotone from "phosphor-astro/MapPinDuotone.astro";

interface Props {
  title: string;
  href: string;
  date: Date;
  description?: string;
  location?: string;
  monthOnly?: boolean;
}

const {
  title,
  href,
  date,
  description,
  location,
  monthOnly = false,
} = Astro.props;

const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  ...(monthOnly ? {} : { day: "numeric" }),
});
---

<article class="py-4">
  <a href={href} class="group block">
    <h3
      class="font-serif font-semibold tracking-wide group-hover:text-accent dark:group-hover:text-accent-light transition-colors"
    >
      {title}
    </h3>
    <div
      class="mt-1 flex items-center gap-3 text-sm text-gray-600 dark:text-gray-400"
    >
      <span class="flex items-center gap-1">
        <CalendarDuotone class="size-3.5" />
        <time datetime={date.toISOString()}>{formattedDate}</time>
      </span>
      {
        location && (
          <span class="flex items-center gap-1">
            <MapPinDuotone class="size-3.5" />
            {location}
          </span>
        )
      }
    </div>
    {
      description && (
        <p class="mt-2 text-gray-600 dark:text-gray-400 text-sm line-clamp-2">
          {description}
        </p>
      )
    }
  </a>
</article>
