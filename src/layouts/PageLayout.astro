---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  intro?: string;
  lastUpdated?: string | null;
}

const { title, intro, lastUpdated } = Astro.props;

const formattedDate = lastUpdated
  ? new Date(lastUpdated).toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;
---

<BaseLayout title={title} description={intro}>
  <div class="mx-auto max-w-6xl px-4 pt-16 sm:pt-24">
    <header class="max-w-3xl">
      <h1
        class="rise font-display text-[clamp(3.75rem,12vw,8.5rem)] leading-[0.92] font-bold tracking-[-0.04em]"
        style="--delay: 80ms"
      >
        {title}<span class="text-accent">.</span>
      </h1>
      {
        (intro || formattedDate) && (
          <div
            class="rise mt-6 flex flex-wrap items-center gap-3"
            style="--delay: 160ms"
          >
            {intro && (
              <p class="font-display text-2xl font-semibold tracking-tight text-ink-soft">
                {intro}
              </p>
            )}
            {formattedDate && (
              <span class="rounded-full border-2 border-line bg-card px-3 py-1 font-mono text-xs font-medium text-ink-soft">
                Updated {formattedDate}
              </span>
            )}
          </div>
        )
      }
    </header>

    <div class="rise mt-14 sm:mt-20" style="--delay: 240ms">
      <slot />
    </div>
  </div>
</BaseLayout>
